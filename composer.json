{
  "name": "applab/ooredooapi",
  "description": "Ooredoo Messenger API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "junaidck",
      "email": "junaid@applab.qa"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^7.2.5|^8.0",
    "ext-soap": "*",
    "ext-xml": "*",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Applab\\Ooredoo\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Applab\\Ooreedo\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "symfony/var-dumper": "5.4.x-dev",
    "phpunit/phpunit": "^9.5"
  },
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit"
  }
}
